# Скопируйте этот файл в .env и поменяйте значения.

# Пароль для входа в дашборд. Если не задан, сервер создаст случайный
# и сохранит его в data/admin_password.txt.
ADMIN_PASSWORD=

# Адрес и порт. Для доступа из сети или с хостинга: HOST=0.0.0.0
HOST=127.0.0.1
PORT=8000

# Где хранить базу SQLite (по умолчанию папка data рядом с проектом).
# DATA_DIR=./data

# Адрес вашего сайта, если форма регистрации стоит на другом домене
# и шлёт заявки на /api/register. Например: https://xpup.example.com
CORS_ORIGIN=

# За HTTPS (рекомендуется на хостинге): куки только по защищённому соединению.
COOKIE_SECURE=false

# Если приложение стоит за nginx или другим прокси, который передаёт
# настоящий адрес клиента в X-Forwarded-For (нужно для ограничения частоты запросов).
TRUST_PROXY=false

# Сколько часов длится вход
SESSION_HOURS=12
